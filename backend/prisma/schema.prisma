generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_OWNER")
}

enum Papel {
  ADMIN
  PSICOLOGO
}

enum Abordagem {
  SISTEMICA
  TCC
  PSICANALISE
  ACT
  HUMANISTA
  OUTRA
}

model Clinica {
  id         String      @id @default(uuid())
  nome       String
  createdAt  DateTime    @default(now())
  psicologos Psicologo[]
}

model Psicologo {
  id              String    @id @default(uuid())
  clinicaId       String
  clinica         Clinica   @relation(fields: [clinicaId], references: [id])
  nome            String
  email           String    @unique
  senhaHash       String
  abordagemPadrao Abordagem
  papel           Papel     @default(PSICOLOGO)
  // Senha definida pelo ADMIN: o guard bloqueia tudo ate a troca (item 62).
  senhaProvisoria Boolean   @default(false)
  // Claim `tv` do JWT. Trocar a senha incrementa: tokens antigos viram 401.
  tokenVersao     Int       @default(0)
  createdAt       DateTime  @default(now())

  // Alvo das FKs compostas (x, clinicaId) das fases futuras.
  @@unique([id, clinicaId])
  // RLS filtra toda consulta por clinicaId.
  @@index([clinicaId])
}
