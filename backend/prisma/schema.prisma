generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_OWNER")
}

enum Papel {
  ADMIN
  PSICOLOGO
}

enum Abordagem {
  SISTEMICA
  TCC
  PSICANALISE
  ACT
  HUMANISTA
  OUTRA
}

model Clinica {
  id         String      @id @default(uuid())
  nome       String
  createdAt  DateTime    @default(now())
  psicologos Psicologo[]
}

model Psicologo {
  id              String      @id @default(uuid())
  clinicaId       String
  clinica         Clinica     @relation(fields: [clinicaId], references: [id])
  nome            String
  email           String      @unique
  senhaHash       String
  abordagemPadrao Abordagem
  papel           Papel       @default(PSICOLOGO)
  // Senha definida pelo ADMIN: o guard bloqueia tudo ate a troca (item 62).
  senhaProvisoria Boolean     @default(false)
  // Claim `tv` do JWT. Trocar a senha incrementa: tokens antigos viram 401.
  tokenVersao     Int         @default(0)
  // Desativado pelo ADMIN (item 58): nao entra mais; dados ficam guardados. Nunca reativa.
  ativo           Boolean     @default(true)
  desativadoEm    DateTime?
  createdAt       DateTime    @default(now())
  pacientes       Paciente[]
  auditorias      Auditoria[]
  sessoes         Sessao[]

  // Alvo das FKs compostas (x, clinicaId) das fases futuras.
  @@unique([id, clinicaId])
  // RLS filtra toda consulta por clinicaId.
  @@index([clinicaId])
}

// Paciente: dado clinico com dono (psicologo). RLS psicologo_proprio (docs/ACESSO.md).
// Identificadores cifrados (AES-256-GCM, AAD = Paciente|<coluna>|id|psicologoId): o id e
// gerado no app antes do INSERT porque entra no AAD.
model Paciente {
  id                String                 @id
  clinicaId         String
  psicologoId       String
  psicologo         Psicologo              @relation(fields: [psicologoId, clinicaId], references: [id, clinicaId])
  nomeCifrado       String
  nascimentoCifrado String?
  telefoneCifrado   String?
  emailCifrado      String?
  criadoEm          DateTime               @default(now())
  atualizadoEm      DateTime               @updatedAt
  consentimentos    Consentimento[]
  convites          ConviteConsentimento[]
  documentos        Documento[]

  // Alvo das FKs compostas das filhas (sessao, documento...): inclui o dono.
  @@unique([id, psicologoId, clinicaId])
  @@index([clinicaId, psicologoId])
}

// Trilha de auditoria (item 11): QUEM fez O QUE em QUE recurso e QUANDO. Somente-acrescentar
// (notta_app so SELECT/INSERT + trigger). NUNCA grava conteudo, nome nem IP. `recursoId` sem FK:
// a trilha sobrevive ao recurso. Valores de acao/recurso: src/auditoria/auditoria.service.ts.
model Auditoria {
  id          String    @id @default(uuid())
  clinicaId   String
  psicologoId String
  psicologo   Psicologo @relation(fields: [psicologoId, clinicaId], references: [id, clinicaId])
  acao        String
  recurso     String
  recursoId   String?
  criadoEm    DateTime  @default(now())

  @@index([clinicaId, psicologoId, criadoEm])
  @@index([clinicaId, recurso, recursoId])
}

// Consentimento do paciente (item 10): cada evento (CONCEDIDO, REVOGADO) e uma linha NOVA; nada
// e sobrescrito. Estado atual = evento da maior `seq`. Somente-acrescentar (notta_app so
// SELECT/INSERT + trigger). `evento` tem CHECK no banco. Termo = snapshot (src/consentimento).
model Consentimento {
  id          String                @id @default(uuid())
  clinicaId   String
  psicologoId String
  pacienteId  String
  paciente    Paciente              @relation(fields: [pacienteId, psicologoId, clinicaId], references: [id, psicologoId, clinicaId], onDelete: Restrict)
  seq         Int
  evento      String
  termoVersao String
  termoTexto  String
  // PSICOLOGO (registro manual) ou PACIENTE (aceite pelo link, item 22). PACIENTE exige
  // `conviteId` (CHECK) e so entra pelo fluxo publico (policy restritiva, ver a migration).
  origem      String                @default("PSICOLOGO")
  conviteId   String?
  convite     ConviteConsentimento? @relation(fields: [conviteId, pacienteId, psicologoId, clinicaId], references: [id, pacienteId, psicologoId, clinicaId], onDelete: Restrict)
  criadoEm    DateTime              @default(now())

  // Duas gravacoes concorrentes no mesmo paciente colidem aqui (409), sem lock. Inclui o dono
  // (a FK ja garante 1 dono por paciente): sem ele, o erro de unique (que ignora RLS) viraria
  // oraculo de existencia de paciente alheio.
  @@unique([pacienteId, psicologoId, seq])
  // Um convite gera no maximo UM evento (com o dono, pelo mesmo motivo do unique acima).
  @@unique([conviteId, pacienteId, psicologoId])
  @@index([clinicaId, psicologoId])
}

// Convite de consentimento por link (item 22): o paciente le e aceita o termo sem criar conta.
// So o SHA-256 do token e gravado (CHECK de formato: o token cru nao cabe). Estado PENDENTE ->
// ACEITO | RECUSADO | CANCELADO e final (trigger, vale para o dono). "Expirado" e derivado
// (PENDENTE com `expiraEm` passado). Indice unico parcial no banco: 1 PENDENTE por paciente.
model ConviteConsentimento {
  id             String          @id @default(uuid())
  clinicaId      String
  psicologoId    String
  pacienteId     String
  paciente       Paciente        @relation(fields: [pacienteId, psicologoId, clinicaId], references: [id, psicologoId, clinicaId], onDelete: Restrict)
  tokenHash      String          @unique
  termoVersao    String
  estado         String          @default("PENDENTE")
  expiraEm       DateTime
  criadoEm       DateTime        @default(now())
  usadoEm        DateTime?
  consentimentos Consentimento[]

  // Alvo da FK de `Consentimento.conviteId` (inclui o dono, padrao docs/ACESSO.md).
  @@unique([id, pacienteId, psicologoId, clinicaId])
  @@index([clinicaId, psicologoId, pacienteId, criadoEm])
}

// Documento clinico (item 12): nota bruta, evolucao ou anamnese. O texto (`conteudoCifrado`) e
// cifrado (AES-256-GCM, AAD = Documento|conteudoCifrado|id|psicologoId); o id nasce no app porque
// entra no AAD. `dataSessao` fica em claro (metadado de linha do tempo, nao e conteudo clinico).
// `tipo` e `status` tem CHECK no banco. Nasce RASCUNHO (a policy de INSERT exige); notta_app so
// SELECT/INSERT (UPDATE entra no item 14, aprovacao no 15).
model Documento {
  id              String      @id
  clinicaId       String
  psicologoId     String
  pacienteId      String
  paciente        Paciente    @relation(fields: [pacienteId, psicologoId, clinicaId], references: [id, psicologoId, clinicaId], onDelete: Restrict)
  tipo            String
  status          String      @default("RASCUNHO")
  dataSessao      DateTime?   @db.Date
  conteudoCifrado String
  aprovadoEm      DateTime?
  substituiId     String?
  // Correcao: este documento corrige um APROVADO do mesmo paciente e dono (o servico confere
  // que o corrigido esta APROVADO; a FK confere paciente e dono).
  substitui       Documento?  @relation("Correcao", fields: [substituiId, pacienteId, psicologoId, clinicaId], references: [id, pacienteId, psicologoId, clinicaId], onDelete: Restrict)
  corrigidoPor    Documento[] @relation("Correcao")
  // Rascunho criado pelo executor da IA (item 19 a 21). Imutavel (trigger documento_imutavel).
  geradoPorIa     Boolean     @default(false)
  origemDe        GeracaoIa[] @relation("Origem")
  geradoEm        GeracaoIa[] @relation("Gerado")
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  @@unique([id, psicologoId, clinicaId])
  @@unique([id, pacienteId, psicologoId, clinicaId])
  @@index([clinicaId, psicologoId, pacienteId, criadoEm])
}

// Pedido de geracao por IA (itens 19, 20 e 21): PREVIA -> PENDENTE -> PRONTO | FALHOU (FALHOU
// retentavel volta a PENDENTE, sem limite). `textoCifrado` = texto anonimizado que a previa
// mostrou e que sai EXATAMENTE assim; `mapaCifrado` = mapa codigo->original (JSON, tem dado
// pessoal em claro por dentro, por isso cifrado). Ambos AES-GCM, AAD = GeracaoIa|<coluna>|id|
// psicologoId, e zerados no PRONTO. Estados, CHECKs e trigger: migration 20261106120000.
// notta_app: SELECT, INSERT e UPDATE so nas colunas de andamento; sem DELETE (retencao: item 52).
model GeracaoIa {
  id            String     @id
  clinicaId     String
  psicologoId   String
  pacienteId    String
  origemId      String
  origem        Documento  @relation("Origem", fields: [origemId, pacienteId, psicologoId, clinicaId], references: [id, pacienteId, psicologoId, clinicaId], onDelete: Restrict)
  tipoDocumento String
  abordagem     String
  estado        String
  motivo        String?
  retentavel    Boolean?
  avisos        String[]   @default([])
  textoCifrado  String?
  mapaCifrado   String?
  documentoId   String?    @unique
  documento     Documento? @relation("Gerado", fields: [documentoId, pacienteId, psicologoId, clinicaId], references: [id, pacienteId, psicologoId, clinicaId], onDelete: Restrict)
  expiraEm      DateTime
  criadoEm      DateTime   @default(now())
  atualizadoEm  DateTime   @updatedAt
  finalizadoEm  DateTime?

  @@index([clinicaId, psicologoId, pacienteId, criadoEm])
  @@index([clinicaId, psicologoId, estado, finalizadoEm])
}

// Sessao segura (itens 46 e 49): uma linha por geracao do refresh; `familia` = um login. So o
// SHA-256 do refresh e gravado. Datas vem SEMPRE do relogio do app (sem default do banco).
model Sessao {
  id              String    @id @default(uuid())
  clinicaId       String
  psicologoId     String
  psicologo       Psicologo @relation(fields: [psicologoId, clinicaId], references: [id, clinicaId])
  familia         String
  refreshHash     String    @unique
  criadoEm        DateTime
  ultimoUsoEm     DateTime
  absolutaAte     DateTime
  usadoEm         DateTime?
  revogadaEm      DateTime?
  motivoRevogacao String?

  @@index([clinicaId, psicologoId])
  @@index([familia])
}
