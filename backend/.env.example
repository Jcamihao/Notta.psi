# Copie para .env e ajuste. Valores abaixo sao FALSOS/de desenvolvimento.

# Porta HTTP (padrao 3000)
PORT=3000

# Runtime: papel notta_app (sem superuser, sujeito a RLS). Obrigatoria.
DATABASE_URL=postgresql://notta_app:notta_app@localhost:5436/notta_psi

# Migrations: papel notta_owner (dono das tabelas). Usada por `prisma migrate` (directUrl)
# e pelo teste de RLS (test/rls.e2e-spec.ts). O runtime NUNCA usa esta URL.
DATABASE_URL_OWNER=postgresql://notta_owner:notta_owner@localhost:5436/notta_psi

# Ambiente. No dev local use development: sem NODE_ENV (ou com qualquer valor que nao seja
# development/test) o boot exige NOTTA_TRUST_PROXY. Em producao use production.
NODE_ENV=development

# Saltos de proxy confiaveis (inteiro >= 0). Valor invalido derruba o boot.
# OBRIGATORIA, exceto com NODE_ENV=development ou test: 0 = sem proxy na frente,
# 1 = um proxy/load balancer (nginx, Caddy...), e assim por diante.
# NOTTA_TRUST_PROXY=1

# Chave mestra da criptografia por clinica: 32 bytes em hex (64 caracteres). Obrigatoria (boot falha sem ela).
# VAZIA de proposito: gere a sua com `openssl rand -hex 32` e cole aqui. Chave fraca (menos de 16
# bytes distintos, ex.: todos iguais ou 00..01) derruba o boot.
# PERDER esta chave = todo conteudo clinico cifrado fica ilegivel para sempre. Guarde backup FORA do banco.
NOTTA_MASTER_KEY=

# Segredo do JWT (HS256, acesso de 15 min; a sessao dura ate 7 dias por refresh rotativo, itens 46 e 49). Obrigatorio (boot falha sem ele).
# VAZIO de proposito: gere o seu com `openssl rand -base64 48` e cole aqui. O boot recusa
# menos de 32 caracteres, menos de 16 caracteres distintos e qualquer valor de exemplo ou de teste conhecido.
# Trocar o segredo derruba todas as sessoes abertas (todo mundo loga de novo).
NOTTA_JWT_SECRET=

# CORS: UMA origem exata (esquema://host[:porta], sem barra no fim). Ausente = CORS desligado
# (o front usa o proxy /api, mesma origem). Nunca `*`. Valor invalido derruba o boot.
# NOTTA_CORS_ORIGIN=https://app.exemplo.com

# IA (SelahIA, itens 17-21 e 42). So o valor exato 1 liga; qualquer outra coisa = desligada.
# PRODUCAO so liga depois que o dono contratar o plano PAGO do Gemini: no plano gratis o Google
# pode usar o conteudo enviado, entao so dado SINTETICO. O Notta.psi anonimiza antes de enviar,
# mas o SelahIA nao anonimiza de novo.
NOTTA_IA_HABILITADA=0
# Quando habilitada, o boot FALHA se: URL ausente/invalida, sem https fora de development/test
# (la so http://localhost ou http://127.0.0.1), com usuario:senha embutidos; ou chave ausente,
# vazia ou de exemplo. A chave e a do app NottaPsiBack, gerada no SelahIA.
# SELAHIA_URL=https://selahia.exemplo.com
# VAZIA de proposito: cole aqui a chave do app NottaPsiBack. Nunca commite.
SELAHIA_API_KEY=
# Geracoes por IA que um psicologo pode concluir (estado PRONTO) por dia, no fuso America/Sao_Paulo
# (item 19). Inteiro >= 1; padrao 20. Valor invalido derruba o boot quando a IA esta habilitada.
# Falhas e pedidos em andamento nao gastam o limite.
# NOTTA_IA_LIMITE_DIARIO=20

# Termo de consentimento por link (item 22).
# Base do link enviado ao paciente: {NOTTA_APP_URL}/termo/{token}. https, sem usuario:senha, sem
# query nem fragmento (invalida derruba o boot). Fora de development/test e OBRIGATORIA; em
# development/test, sem ela, vale http://localhost:4200 (so localhost ou 127.0.0.1 aceitam http).
# NOTTA_APP_URL=https://app.exemplo.com
# O texto do termo (src/consentimento/termo-consentimento.ts) e um RASCUNHO nao revisado. Fora de
# development/test o boot FALHA se esta variavel nao for exatamente 1. So o dono liga, depois da
# revisao juridica do texto (e de trocar a `versao` dele).
NOTTA_TERMO_REVISADO=0

# Sessao segura (itens 46 e 49). Base da API como o NAVEGADOR a ve atras do proxy: o cookie de refresh
# so viaja para <prefixo>/auth/*. Padrao /api (nginx tira o prefixo antes do back). Vazio = API na raiz.
# Caminho como /api, sem barra no fim; invalido derruba o boot.
# NOTTA_API_PREFIXO=/api
# Origem aceita no CSRF (checagem de Origin/Referer): NOTTA_APP_URL (acima) e, se definida,
# NOTTA_CORS_ORIGIN. Em development/test, sem nenhuma, vale http://localhost:4200.
