{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/(acesso|acesso-psicologo|carga-clinicas|documentos-rls|auditoria-rls|consentimento-rls|transferir-pacientes)\\.e2e-spec\\.ts$"
  ],
  "setupFiles": [
    "<rootDir>/permite-segredo-de-teste.ts",
    "<rootDir>/exigir-banco.ts"
  ],
  "testTimeout": 30000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
