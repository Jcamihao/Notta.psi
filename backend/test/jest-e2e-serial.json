{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "/(acesso|acesso-psicologo|carga-clinicas|documentos-rls|auditoria-rls|consentimento-rls)\\.e2e-spec\\.ts$",
  "maxWorkers": 1,
  "setupFiles": [
    "<rootDir>/permite-segredo-de-teste.ts",
    "<rootDir>/exigir-banco.ts"
  ],
  "testTimeout": 30000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
